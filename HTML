<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>University Admission</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <h1>ABC University</h1>
        <p>Your Future Begins Here</p>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a>
        <a href="#courses">Courses</a>
        <a href="#eligibility">Eligibility</a>
        <a href="#admission">Admission</a>
        <a href="#contact">Contact</a>
    </nav>

    <!-- Home Section -->
    <section id="home" class="hero">
        <h2>Admissions Open 2026-27</h2>

        <p>
            Join ABC University and build your successful future
            with quality education and excellent facilities.
        </p>

        <a href="#application" class="btn">
            Apply Now
        </a>
    </section>

    <!-- Courses Section -->
    <section id="courses" class="container">

        <h2>Our Courses</h2>

        <div class="course-container">

            <div class="course-card">
                <h3>B.Tech</h3>
                <p>Computer Science, AI & ML, ECE</p>
                <p>Duration: 4 Years</p>
                <p>Fee: ₹1,00,000 / Year</p>
            </div>

            <div class="course-card">
                <h3>MBA</h3>
                <p>Finance, Marketing, HR</p>
                <p>Duration: 2 Years</p>
                <p>Fee: ₹80,000 / Year</p>
            </div>

            <div class="course-card">
                <h3>BBA</h3>
                <p>Business Administration</p>
                <p>Duration: 3 Years</p>
                <p>Fee: ₹60,000 / Year</p>
            </div>

        </div>

    </section>

    <!-- Eligibility Section -->
    <section id="eligibility" class="container">

        <h2>Eligibility Criteria</h2>

        <ul>
            <li>Students must have completed 10+2 education.</li>
            <li>Students must have the required subjects for their chosen course.</li>
            <li>Minimum qualifying marks must be obtained.</li>
            <li>Entrance examination scores may be required.</li>
        </ul>

    </section>

    <!-- Fee Details -->
    <section id="fees" class="container">

        <h2>Fee Details</h2>

        <table>
            <tr>
                <th>Course</th>
                <th>Duration</th>
                <th>Annual Fee</th>
            </tr>

            <tr>
                <td>B.Tech</td>
                <td>4 Years</td>
                <td>₹1,00,000</td>
            </tr>

            <tr>
                <td>MBA</td>
                <td>2 Years</td>
                <td>₹80,000</td>
            </tr>

            <tr>
                <td>BBA</td>
                <td>3 Years</td>
                <td>₹60,000</td>
            </tr>
        </table>

    </section>

    <!-- Admission Process -->
    <section id="admission" class="container">

        <h2>Admission Process</h2>

        <div class="steps">

            <div class="step">
                <h3>Step 1</h3>
                <p>Register Online</p>
            </div>

            <div class="step">
                <h3>Step 2</h3>
                <p>Submit Application</p>
            </div>

            <div class="step">
                <h3>Step 3</h3>
                <p>Document Verification</p>
            </div>

            <div class="step">
                <h3>Step 4</h3>
                <p>Confirm Admission</p>
            </div>

        </div>

    </section>

    <!-- Important Dates -->
    <section id="dates" class="container">

        <h2>Important Dates</h2>

        <ul>
            <li>Application Start: June 1, 2026</li>
            <li>Last Date to Apply: August 15, 2026</li>
            <li>Merit List: August 20, 2026</li>
            <li>Classes Begin: September 1, 2026</li>
        </ul>

    </section>

    <!-- FAQ Section -->
    <section id="faq" class="container">

        <h2>Frequently Asked Questions</h2>

        <details>
            <summary>How can I apply for admission?</summary>
            <p>Fill out the online application form below.</p>
        </details>

        <details>
            <summary>Are scholarships available?</summary>
            <p>Yes, scholarships are available for eligible students.</p>
        </details>

        <details>
            <summary>Can I apply for multiple courses?</summary>
            <p>Yes, students can apply for multiple courses.</p>
        </details>

    </section>

    <!-- Application Form -->
    <section id="application" class="container">

        <h2>Online Application Form</h2>

        <form>

            <label for="name">Full Name:</label>
            <input type="text" id="name" name="name"
                   placeholder="Enter your name" required>

            <label for="email">Email Address:</label>
            <input type="email" id="email" name="email"
                   placeholder="Enter your email" required>

            <label for="phone">Phone Number:</label>
            <input type="tel" id="phone" name="phone"
                   placeholder="Enter your phone number" required>

            <label for="course">Select Course:</label>
            <select id="course" name="course" required>
                <option value="">Choose a course</option>
                <option value="btech">B.Tech</option>
                <option value="mba">MBA</option>
                <option value="bba">BBA</option>
            </select>

            <label for="qualification">Previous Qualification:</label>
            <input type="text" id="qualification"
                   name="qualification"
                   placeholder="Enter your qualification" required>

            <button type="submit">Submit Application</button>

        </form>

    </section>

    <!-- Contact Section -->
    <section id="contact" class="container">

        <h2>Contact Us</h2>

        <p>Email: admissions@abcuniversity.edu</p>
        <p>Phone: +91 98765 43210</p>
        <p>Address: ABC University, Hyderabad, Telangana</p>

    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 ABC University. All Rights Reserved.</p>
    </footer>

</body>
</html>
